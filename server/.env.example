PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/projectify?retryWrites=true&w=majority

# Redis (Upstash Redis TLS connection string)
REDIS_URL=rediss://default:<redis_token>@<upstash-endpoint>.upstash.io:6379

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=<64_char_hex_secret_for_access_tokens>
JWT_REFRESH_SECRET=<64_char_hex_secret_for_refresh_tokens>

# Frontend Client URL (for CORS and email redirect links, NO trailing slash)
CLIENT_URL=https://projectify-steel.vercel.app
FRONTEND_URL=https://projectify-steel.vercel.app

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized JavaScript origins:
#   - https://projectify-steel.vercel.app
#   - https://projectify-api-yogd.onrender.com
#   - http://localhost:5173
# Authorized redirect URIs:
#   - https://projectify-api-yogd.onrender.com/api/auth/google/callback
#   - http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=<your_google_client_id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-<your_google_client_secret>
GOOGLE_CALLBACK_URL=https://projectify-api-yogd.onrender.com/api/auth/google/callback

# Transactional Email (Brevo HTTPS REST API on port 443; free 300 emails/day)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-<your_brevo_api_key>
RESEND_API_KEY=re_<your_resend_api_key>
EMAIL_FROM=Projectify <<your_verified_sender_email>@gmail.com>

# Diagnostic Tooling (Optional)
DEBUG_SECRET=
ENABLE_DEBUG_ENDPOINTS=false
